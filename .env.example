# Copiar estas variables en Vercel → Project → Settings → Environment Variables.
# No subir nunca valores reales a git ni pegarlos en chats.

# URL pública del sitio, sin barra final (ej.: https://sismo-halloween.vercel.app)
SITE_URL=

# Mercado Pago → Tus integraciones → Credenciales de producción → Access Token
MP_ACCESS_TOKEN=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail que envía las entradas + contraseña de aplicación (no la contraseña normal)
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# PIN que usa el equipo de puerta para escanear en /puerta
DOOR_PIN=
